{
  "name": "convivo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typegen": "supabase gen types --lang typescript --remote=$SUPABASE_PROJECT_REF --schema public > src/types/database.types.ts && oxfmt src/types/database.types.ts",
    "typegen:local": "supabase gen types --lang typescript --schema public > src/types/database.types.ts && oxfmt src/types/database.types.ts",
    "db:push": "supabase db push",
    "typegen:db": "supabase gen types --lang typescript --schema public --remote=\"$SUPABASE_DB_URL\" > src/types/database.types.ts && oxfmt src/types/database.types.ts",
    "test:db": "vitest run tests/db",
    "db:bundle": "node scripts/bundle-sql.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@sentry/nextjs": "11.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "oxfmt": "^0.76.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
