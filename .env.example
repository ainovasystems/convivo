# Copia este fichero a .env.local y rellénalo. NUNCA subas .env.local al repo.
# En la nube, mete estos valores en los ajustes del entorno, no en el chat.

# Públicas (llegan al navegador; la anon key está pensada para ello y la protege RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO servidor. Se salta RLS. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Referencia del proyecto (la parte xxxx de https://xxxx.supabase.co), para `npm run typegen`
SUPABASE_PROJECT_REF=
